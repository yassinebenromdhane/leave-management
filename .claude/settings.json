{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "TZ": "UTC",
    "NODE_OPTIONS": "--enable-source-maps",
    "FORCE_COLOR": "0"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm add*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm build*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm test*)",
      "Bash(pnpm exec vitest*)",
      "Bash(pnpm exec tsc*)",
      "Bash(pnpm exec eslint*)",
      "Bash(pnpm --filter * test*)",
      "Bash(pnpm --filter * typecheck*)",
      "Bash(pnpm --filter * lint*)",
      "Bash(pnpm --filter * exec vitest*)",
      "Bash(pnpm --filter * exec tsc*)",
      "Bash(pnpm --filter @leave/server db:generate*)",
      "Bash(pnpm --filter @leave/server db:migrate*)",
      "Bash(pnpm --filter @leave/server db:seed*)",
      "Bash(pnpm -r *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose up -d db*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(node --version)",
      "Bash(pnpm --version)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(pnpm remove*)",
      "Bash(pnpm up*)",
      "Bash(pnpm update*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./uploads/**)",
      "Bash(*drizzle-kit push*)",
      "Bash(pnpm --filter @leave/server db:push*)",
      "Bash(docker compose down -v*)",
      "Bash(docker volume rm*)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-invariants.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.mjs\"",
            "timeout": 240
          }
        ]
      }
    ]
  }
}

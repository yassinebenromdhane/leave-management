# Copy to .env and fill in. Never commit .env.

# --- Runtime ---
NODE_ENV=development
PORT=3000
# Built React app served by Hono (relative to the server's working directory)
WEB_DIST=../web/dist
# Attachments (medical certificates): outside any public folder
UPLOAD_DIR=../uploads

# --- PostgreSQL ---
POSTGRES_USER=leave
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leave
# Local dev talks to the compose db on 127.0.0.1; inside compose the app uses host "db"
DATABASE_URL=postgres://leave:change-me@127.0.0.1:5432/leave

# --- Seed ---
# Language of seeded leave-type and holiday names: fr | en
SEED_LOCALE=fr

# --- Hosting (Caddy) ---
APP_DOMAIN=leave.example.com

# --- Auth (step 2) ---
# BETTER_AUTH_SECRET=
# OPERATOR_EMAIL=
# OPERATOR_INITIAL_PASSWORD=

# --- Email via Brevo SMTP (step 2) ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Leave <no-reply@example.com>"

{
  "name": "@leave/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:create": "tsx src/db/createDb.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@leave/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "~1.7.25",
    "csv-stringify": "6.9.0",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "hono": "^4.13.18",
    "nodemailer": "^10.5.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
